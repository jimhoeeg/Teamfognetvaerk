{
  "framework": "vite",
  "rewrites": [{ "source": "/((?!assets/|sw.js|workbox-|manifest.webmanifest|icon.svg|registerSW.js).*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/(.*)", "headers": [{ "key": "Permissions-Policy", "value": "camera=(self), microphone=(self)" }] }
  ]
}
